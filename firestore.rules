rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Menu + site content: anyone can read (the public website needs this),
    // only a signed-in admin can write.
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: anyone can create one (checkout, unauthenticated), but only a
    // signed-in admin can read, list, update, or delete them.
    match /orders/{orderId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['id', 'customer', 'items', 'total'])
                    && request.resource.data.customer.keys().hasAll(['name', 'phone', 'address'])
                    && request.resource.data.items is list
                    && request.resource.data.total is number;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
